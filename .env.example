# Directory the SQLite database (baton.db) lives in. Defaults to ./data.
# On Render's free tier the filesystem is ephemeral — this file is wiped on
# every deploy/restart unless a persistent disk is mounted at this exact
# path (requires a paid instance type). Point this at that mount path once
# you attach one, or swap the app to Render Postgres later.
DATA_DIR=

# Session cookie signing secret — set this to a long random string in any
# real deployment; the 'changeme' default is fine for local dev only.
SESSION_SECRET=

# Username/password for the single account created on first boot (a fresh
# install has no other accounts). Defaults to admin/soc2026 if unset —
# change the password from the UI immediately after logging in either way.
SOC_USER=
SOC_PASS=

# Optional: enables AI-assisted schedule generation in the admin panel.
# Get a free key at https://openrouter.ai/ — the auto-generate feature works
# fine without this (falls back to the built-in deterministic generator).
OPENROUTER_API_KEY=

# Any model id from https://openrouter.ai/models?max_price=0 (free tier).
# Verify the slug is still live before relying on it — free models rotate.
# nvidia/nemotron-3-super-120b-a12b:free was confirmed working as of 2026-08-23.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
