# Directory local files (backup snapshots, audit.log, and — only if
# TURSO_DATABASE_URL below is unset — the SQLite database itself) live in.
# Defaults to ./data. No need to touch this for a Turso-backed deployment
# (e.g. Render's free tier, whose filesystem is ephemeral) — see
# TURSO_DATABASE_URL below, which is what actually makes the database survive
# restarts/redeploys there.
DATA_DIR=

# Leave unset for local dev — the app then uses a plain SQLite file under
# DATA_DIR, no account needed. Set this (+ TURSO_AUTH_TOKEN) in production to
# use a Turso cloud database instead, so the data survives on hosts with an
# ephemeral filesystem (Render free tier, etc.). See README.md
# "Turso (cloud SQLite) setup" for how to get these two values.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Session cookie signing secret — set this to a long random string in any
# real deployment; the 'changeme' default is fine for local dev only.
SESSION_SECRET=

# Username/password for the single account created on first boot (a fresh
# install has no other accounts). Defaults to admin/soc2026 if unset —
# change the password from the UI immediately after logging in either way.
SOC_USER=
SOC_PASS=

# Optional: enables AI-assisted schedule generation in the admin panel.
# Get a free key at https://openrouter.ai/ — the auto-generate feature works
# fine without this (falls back to the built-in deterministic generator).
OPENROUTER_API_KEY=

# Any model id from https://openrouter.ai/models?max_price=0 (free tier).
# Verify the slug is still live before relying on it — free models rotate.
# nvidia/nemotron-3-super-120b-a12b:free was confirmed working as of 2026-08-23.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Optional: enables automatic off-site backup of documents + the database to
# Google Drive (see README.md "Google Drive integration"). Get these from a
# Google Cloud OAuth client (type: Desktop app), then run
# `node scripts/google-auth-setup.js` once to finish connecting — that step
# writes data/google-token.json, which is what actually turns the feature on.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
