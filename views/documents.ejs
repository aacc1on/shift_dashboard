<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SOCGrid // DOCUMENTS</title>
  <script>if(localStorage.getItem('soc_theme')==='light'){document.documentElement.classList.add('prelight');document.addEventListener('DOMContentLoaded',()=>document.body.classList.add('light'));}</script>
  <link rel="icon" type="image/svg+xml" href="/img/logo.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@400;700;900&family=Rajdhani:wght@300;400;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
<div class="scanlines"></div><div class="grid-bg"></div>
<header class="hdr">
  <div class="hdr-left"><span class="hdr-badge">SYS:ONLINE</span></div>
  <div class="hdr-title"><div class="logo-line"><img class="logo-icon" src="/img/logo.svg" alt="" />SOCGrid</div><div class="sub-logo">// DOCUMENTATION //</div></div>
  <div class="hdr-right">
    <button class="hdr-badge" id="theme-toggle" type="button">☀/🌙</button>
    <a class="hdr-badge" href="/chat">💬 CHAT</a>
    <a class="hdr-badge" href="/network">🌐 NETWORK</a>
    <a class="hdr-badge green" href="/">◀ DASHBOARD</a>
    <% if (authRole === 'lead') { %><a class="hdr-badge green" href="/admin">⚙ ADMIN</a><% } %>
    <span class="hdr-badge" id="live-clock">--:--:--</span>
  </div>
</header>

<div class="tab-bar">
  <button class="tab-btn active" data-tab="documents" type="button">📄 DOCUMENTS</button>
  <button class="tab-btn" data-tab="reports" type="button">📋 HANDOVER REPORTS</button>
</div>

<section class="section" id="tab-documents">
  <div class="doc-toolbar">
    <input id="doc-search" type="text" placeholder="search documents…" />
    <button class="admin-btn primary" id="doc-new-btn" type="button" style="width:auto">+ New Document</button>
  </div>

  <div class="doc-browse-layout">
    <div class="doc-categories">
      <div class="admin-sidebar-title">// CATEGORIES</div>
      <div id="category-list"><span style="opacity:.4">Loading…</span></div>

      <div style="margin-top:20px; border-top:1px solid var(--border); padding-top:16px;">
        <div class="admin-sidebar-title">// TEMPLATES</div>
        <div id="template-list"><span style="opacity:.4">Loading…</span></div>
      </div>
    </div>

    <div class="doc-main">
      <div id="doc-active-filter" class="doc-active-filter" hidden></div>
      <div id="doc-results" class="doc-grid"><span style="opacity:.4">Loading…</span></div>
    </div>
  </div>
</section>

<section class="section" id="tab-reports" hidden>
  <div class="doc-toolbar">
    <input id="report-search" type="text" placeholder="search reports…" />
    <input id="report-from" type="date" />
    <input id="report-to" type="date" />
    <button class="admin-btn" id="report-search-btn" type="button" style="width:auto">Search</button>
  </div>
  <div id="report-results" class="doc-list"><span style="opacity:.4">Loading…</span></div>
</section>

<!-- CREATE / EDIT MODAL -->
<div id="doc-edit-backdrop" class="modal-backdrop" hidden>
  <div class="modal-box" style="max-width:640px;">
    <div class="section-header"><span class="section-icon">▶</span><span id="doc-form-title" style="flex:1">NEW DOCUMENT</span><span class="section-line"></span></div>
    <input id="doc-editing-id" type="hidden" value="" />
    <div class="sidebar-field">
      <label>// CATEGORY</label>
      <input id="doc-type" type="text" list="doc-type-options" placeholder="pick an existing category or type a new one" />
      <datalist id="doc-type-options"></datalist>
    </div>
    <div class="sidebar-field" style="margin-top:10px">
      <label>// TITLE</label>
      <input id="doc-title" type="text" />
    </div>
    <div class="sidebar-field" style="margin-top:10px">
      <label>// TAGS (comma-separated)</label>
      <input id="doc-tags" type="text" />
    </div>
    <div class="sidebar-field" style="margin-top:10px">
      <label>// CONTENT — markdown supported (# headings, **bold**, *italic*, - lists, `code`, ```blocks```, [links](url))</label>
      <textarea id="doc-content" rows="9"></textarea>
    </div>
    <div class="sidebar-field" style="margin-top:10px">
      <label>// VISIBILITY</label>
      <select id="doc-visibility">
        <option value="team">Team — whole SOC</option>
        <option value="shift">Shift handoff — private, next operator only</option>
        <option value="restricted">🔒 Restricted (top secret) — only people you pick</option>
        <% if (authRole === 'lead') { %><option value="published">Published — locked, official</option><% } %>
      </select>
    </div>
    <div class="sidebar-field" id="doc-restricted-picker" style="margin-top:10px" hidden>
      <label>// WHO CAN READ THIS</label>
      <div id="doc-restricted-checklist" style="max-height:160px;overflow-y:auto;border:1px solid var(--border2);padding:8px;"></div>
    </div>
    <label style="display:flex;align-items:center;gap:6px;margin-top:10px;font-family:var(--font-mono);font-size:0.65rem;color:var(--text-dim);">
      <input id="doc-is-template" type="checkbox" style="width:auto" /> Save as reusable template
    </label>
    <div style="display:flex;gap:8px;margin-top:14px;">
      <button class="admin-btn primary" id="doc-create-btn" type="button" style="width:auto;flex:1">▶ SAVE DOCUMENT</button>
      <button class="admin-btn" id="doc-cancel-edit-btn" type="button" style="width:auto;flex:0 0 auto">Cancel</button>
    </div>
    <div class="admin-feedback" id="doc-feedback" style="margin-top:10px"></div>
  </div>
</div>

<!-- VIEW MODAL -->
<div id="doc-view-backdrop" class="modal-backdrop" hidden>
  <div class="modal-box" style="max-width:720px;">
    <div class="section-header">
      <span class="section-icon">▶</span>
      <span id="doc-view-title" style="flex:1">Document</span>
      <span class="section-line"></span>
    </div>
    <div id="doc-view-meta" class="doc-item-meta" style="margin-bottom:14px;"></div>
    <div id="doc-view-content" class="markdown-body"></div>
    <div style="display:flex; gap:8px; margin-top:18px; flex-wrap:wrap;">
      <button class="admin-btn" id="doc-view-edit-btn" type="button" style="width:auto" hidden>Edit</button>
      <button class="admin-btn danger" id="doc-view-delete-btn" type="button" style="width:auto" hidden>Delete</button>
      <button class="admin-btn ai" id="doc-view-publish-btn" type="button" style="width:auto" hidden>Publish</button>
      <button class="admin-btn danger" id="doc-view-unpublish-btn" type="button" style="width:auto" hidden>Unpublish</button>
      <button class="admin-btn primary" id="doc-view-close-btn" type="button" style="width:auto;margin-left:auto">Close</button>
    </div>
  </div>
</div>

<script>window.SOC_DOCS = { authRole: <%- JSON.stringify(authRole) %>, authUserId: <%= authUserId %> };</script>
<script src="/js/documents.js"></script>
<script src="/js/profile-widget.js"></script>
</body></html>
