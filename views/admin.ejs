<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SOC // ADMIN</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@400;700;900&family=Rajdhani:wght@300;400;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="scanlines"></div>
  <div class="grid-bg"></div>

  <header class="hdr">
    <div class="hdr-left">
      <span class="hdr-badge">SYS:ADMIN</span>
      <span class="hdr-badge orange">ACCESS:SECURE</span>
    </div>
    <div class="hdr-title">
      <div class="logo-line">SOC</div>
      <div class="sub-logo">// ADMIN CONTROL PANEL //</div>
    </div>
    <div class="hdr-right">
      <a class="hdr-badge green" href="/">← DASHBOARD</a>
      <a class="hdr-badge red" href="/logout">LOGOUT</a>
      <span class="hdr-badge" id="live-clock">--:--:--</span>
    </div>
  </header>

  <div class="status-bar">
    <span class="blink-dot" style="background:var(--orange);box-shadow:0 0 8px var(--orange)"></span>
    <span style="color:var(--orange)">ADMIN SESSION ACTIVE — CHANGES APPLY IMMEDIATELY</span>
    <span style="margin-left:auto; font-size:0.65rem; opacity:0.4; font-family:var(--font-mono);">AUTH: SESSION</span>
  </div>

  <section class="section">
    <div class="section-header">
      <span class="section-icon">▶</span> SCHEDULE EDITOR
      <span class="section-line"></span>
    </div>

    <div class="admin-layout">
      <!-- SIDEBAR -->
      <div class="admin-sidebar">
        <div class="admin-sidebar-title">// ACTIONS</div>

        <div class="sidebar-field">
          <label>// ADD OPERATOR</label>
          <input id="new-person" type="text" placeholder="operator name" />
        </div>
        <button class="admin-btn" id="add-person-btn" type="button">+ Add Operator</button>

        <div class="sidebar-field" style="margin-top:16px">
          <label>// ADD DATE</label>
          <input id="new-date" type="date" />
        </div>
        <button class="admin-btn" id="add-date-btn" type="button">+ Add Date</button>

        <div style="border-top:1px solid var(--border); margin:20px 0 16px;"></div>

        <button class="admin-btn primary" id="save-admin-btn" type="button">▶ SAVE CHANGES</button>
        <button class="admin-btn danger" id="reset-admin-btn" type="button">↺ Reload from Server</button>
        <a class="admin-btn" href="/api/export/csv" target="_blank" rel="noopener">⤓ Export CSV</a>

        <div style="margin-top:20px; border-top:1px solid var(--border); padding-top:16px;">
          <div class="admin-sidebar-title">// QUICK STATS</div>
          <div id="sidebar-stats" style="font-family:var(--font-mono);font-size:0.65rem;color:var(--text-dim);line-height:2;"></div>
        </div>

        <div style="margin-top:20px; border-top:1px solid var(--border); padding-top:16px;">
          <div class="admin-sidebar-title">// PENDING SWAPS</div>
          <div id="pending-swaps" style="font-family:var(--font-mono);font-size:0.62rem;color:var(--text-dim);line-height:1.6;"></div>
        </div>
      </div>

      <!-- MAIN TABLE -->
      <div class="admin-main">
        <div class="admin-table-wrap">
          <table id="admin-table"></table>
        </div>
        <div class="admin-feedback" id="admin-feedback"></div>
      </div>
    </div>
  </section>

  <script>window.SOC_INIT = { people: <%- JSON.stringify(people) %>, dates: <%- JSON.stringify(dates) %>, schedule: <%- JSON.stringify(schedule) %> };</script>
  <script src="/js/admin.js"></script>
</body>
</html>
