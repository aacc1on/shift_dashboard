<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SOCGrid // TEAM CHAT</title>
  <script>if(localStorage.getItem('soc_theme')==='light'){document.documentElement.classList.add('prelight');document.addEventListener('DOMContentLoaded',()=>document.body.classList.add('light'));}</script>
  <link rel="icon" type="image/svg+xml" href="/img/logo.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@400;700;900&family=Rajdhani:wght@300;400;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
<div class="scanlines"></div><div class="grid-bg"></div>
<header class="hdr">
  <div class="hdr-left"><span class="hdr-badge">SYS:ONLINE</span></div>
  <div class="hdr-title"><div class="logo-line"><img class="logo-icon" src="/img/logo.svg" alt="" />SOCGrid</div><div class="sub-logo">// TEAM CHAT //</div></div>
  <div class="hdr-right">
    <button class="hdr-badge" id="theme-toggle" type="button">☀/🌙</button>
    <a class="hdr-badge" href="/documents">📄 DOCS</a>
    <a class="hdr-badge green" href="/">◀ DASHBOARD</a>
    <% if (authRole === 'lead') { %><a class="hdr-badge green" href="/admin">⚙ ADMIN</a><% } %>
    <span class="hdr-badge" id="live-clock">--:--:--</span>
  </div>
</header>

<section class="section">
  <div class="section-header"><span class="section-icon">▶</span> COMMUNICATION <span class="section-line"></span></div>

  <div class="chat-layout">
    <div class="chat-sidebar">
      <div class="chat-channel-item active" data-channel="team">
        <span class="chat-channel-icon">📢</span> Team Channel
      </div>

      <div class="admin-sidebar-title" style="margin-top:18px">// DIRECT MESSAGES</div>
      <div id="dm-conversation-list"><span style="opacity:.4">Loading…</span></div>

      <button class="admin-btn" id="dm-new-btn" type="button" style="margin-top:12px">+ New Direct Message</button>
    </div>

    <div class="chat-main">
      <div id="chat-header" class="chat-header">📢 Team Channel — visible to everyone</div>
      <div id="chat-log" class="chat-log"><span style="opacity:.4">Loading…</span></div>
      <div class="chat-input-row">
        <input id="chat-input" type="text" placeholder="Message the team…" maxlength="2000" />
        <button class="admin-btn primary" id="chat-send-btn" type="button" style="width:auto">Send</button>
      </div>
      <div class="admin-feedback" id="chat-feedback" style="margin-top:8px"></div>
    </div>
  </div>
</section>

<div id="dm-new-backdrop" class="modal-backdrop" hidden>
  <div class="modal-box">
    <div class="section-header"><span class="section-icon">▶</span> START A DIRECT MESSAGE <span class="section-line"></span></div>
    <div id="dm-new-list" style="max-height:50vh;overflow-y:auto;"><span style="opacity:.4">Loading…</span></div>
    <button class="admin-btn" id="dm-new-close-btn" type="button" style="width:auto;margin-top:14px">Close</button>
  </div>
</div>

<script>window.SOC_CHAT = { authUserId: <%= authUserId %> };</script>
<script src="/js/chat.js"></script>
<script src="/js/profile-widget.js"></script>
</body></html>
