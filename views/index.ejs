<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SOCGrid // SHIFT COMMAND CENTER</title>
  <script>if(localStorage.getItem('soc_theme')==='light'){document.documentElement.classList.add('prelight');document.addEventListener('DOMContentLoaded',()=>document.body.classList.add('light'));}</script>
  <link rel="icon" type="image/svg+xml" href="/img/logo.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@400;700;900&family=Rajdhani:wght@300;400;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
<div class="scanlines"></div><div class="grid-bg"></div>
<header class="hdr"><div class="hdr-left"><span class="hdr-badge">SYS:ONLINE</span><span class="hdr-badge green">SEC:LVL3</span></div><div class="hdr-title"><div class="logo-line"><img class="logo-icon" src="/img/logo.svg" alt="" />SOCGrid</div><div class="sub-logo">// SHIFT COMMAND CENTER //</div></div><div class="hdr-right"><button class="hdr-badge" id="theme-toggle" type="button">☀/🌙</button><a class="hdr-badge" href="/chat">💬 CHAT</a><a class="hdr-badge" href="/documents">📄 DOCS</a><a class="hdr-badge green" href="/admin">⚙ ADMIN</a><span class="hdr-badge" id="live-clock">--:--:--</span></div></header>
<div class="status-bar"><span class="blink-dot"></span><span id="status-txt">INITIALIZING FEED...</span><span style="margin-left:auto; font-size:0.65rem; opacity:0.4; font-family:var(--font-mono);">SYNC: 1s</span></div>
<div id="warnings-banner" class="warnings-banner" hidden></div>
<div id="report-due-banner" class="warnings-banner report-due" hidden></div>
<div id="incoming-report-card" class="incoming-report" hidden></div>
<div class="stats-row" id="stats-row"><div class="stat-cell"><div class="stat-label">// ON DUTY</div><div class="stat-value green" id="stat-on">–</div></div><div class="stat-cell"><div class="stat-label">// DAY SHIFT</div><div class="stat-value green" id="stat-day">–</div></div><div class="stat-cell"><div class="stat-label">// EVENING SHIFT</div><div class="stat-value yellow" id="stat-eve">–</div></div><div class="stat-cell"><div class="stat-label">// NIGHT SHIFT</div><div class="stat-value orange" id="stat-night">–</div></div></div>
<section class="section"><div class="section-header"><span class="section-icon">▶</span> PERSONNEL ON DUTY <span class="section-line"></span><span class="section-count" id="duty-count">0 / <%= people.length %></span></div><div class="cards-grid" id="cards-grid"></div></section>
<section class="section"><div class="section-header"><span class="section-icon">▶</span> SCHEDULE MATRIX <span class="section-line"></span><span class="section-count">WEEK <%= weekLabel %></span></div><div style="display:flex;gap:8px;margin-bottom:10px;"><a class="hdr-badge" href="/?week=<%= week - 1 %>">← PREV WEEK</a><a class="hdr-badge" href="/?week=<%= week + 1 %>">NEXT WEEK →</a></div>
<% const today = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Yerevan' }); const sortedDates = dates; %>
<% if (!sortedDates.length) { %><div class="empty-state">NO SCHEDULE DATA FOR THIS WEEK.</div><% } else { %>
<div class="table-wrap"><table class="sched-table"><thead><tr><th>OPERATOR</th><% sortedDates.forEach(d=>{ %><th class="<%= d===today?'today-col':'' %>"><%= d.slice(5) %><%= d===today?' ◈':'' %></th><% }) %></tr></thead><tbody><% people.forEach(person=>{ %><tr><td class="person-cell"><%= person.toUpperCase() %></td><% sortedDates.forEach(d=>{ const code=schedule[d]&&schedule[d][person]?schedule[d][person]:'X'; const info=shiftTimes[code]||shiftTimes.X; %><td class="shift-cell <%= d===today?'today-col':'' %>"><span class="shift-badge" style="color:<%= info.color %>; border-color:<%= info.color %>40"><%= code %></span></td><% }) %></tr><% }) %></tbody></table></div><% } %>
</section>
<section class="section"><div class="section-header"><span class="section-icon">▶</span> SWAP REQUESTS <span class="section-line"></span></div>
  <div class="swap-layout">
    <div class="swap-form">
      <div class="sidebar-field">
        <label>// YOUR SHIFT TO OFFER</label>
        <select id="swap-shift-select"><option value="">Loading…</option></select>
      </div>
      <div class="sidebar-field" style="margin-top:12px">
        <label>// OFFER TO</label>
        <select id="swap-target-select"><option value="">Loading…</option></select>
      </div>
      <button class="admin-btn primary" id="swap-request-btn" type="button" style="margin-top:12px">▶ REQUEST SWAP</button>
      <div class="admin-feedback" id="swap-feedback" style="margin-top:10px"></div>
    </div>
    <div class="swap-lists">
      <div class="swap-list-col">
        <div class="admin-sidebar-title">// INCOMING — NEEDS YOUR REPLY</div>
        <div id="swap-incoming" class="swap-list"><span style="opacity:.4">Loading…</span></div>
      </div>
      <div class="swap-list-col">
        <div class="admin-sidebar-title">// YOUR OUTGOING REQUESTS</div>
        <div id="swap-outgoing" class="swap-list"><span style="opacity:.4">Loading…</span></div>
      </div>
    </div>
  </div>
</section>
<div id="report-modal-backdrop" class="modal-backdrop" hidden>
  <div class="modal-box">
    <div class="section-header"><span class="section-icon">▶</span> HANDOVER REPORT <span class="section-line"></span></div>
    <div class="sidebar-field">
      <label>// WHAT WAS DONE THIS SHIFT (required)</label>
      <textarea id="report-what-done" rows="3"></textarea>
    </div>
    <div class="sidebar-field" style="margin-top:12px">
      <label>// WHAT'S UNFINISHED / NEEDS CONTINUITY</label>
      <textarea id="report-unfinished" rows="3"></textarea>
    </div>
    <div class="sidebar-field" style="margin-top:12px">
      <label>// OPEN ITEMS (one per line, in priority order)</label>
      <textarea id="report-open-items" rows="3"></textarea>
    </div>
    <div style="display:flex; gap:8px; margin-top:14px;">
      <button class="admin-btn primary" id="report-submit-btn" type="button" style="width:auto;flex:1">▶ SUBMIT & CLOSE SHIFT</button>
      <button class="admin-btn" id="report-cancel-btn" type="button" style="width:auto;flex:0 0 auto">Later</button>
    </div>
    <div class="admin-feedback" id="report-feedback" style="margin-top:10px"></div>
  </div>
</div>
<template id="card-tpl"><div class="person-card" data-person=""><div class="card-header"><span class="card-name"></span><span class="card-badge"></span></div><div class="card-shift-label"></div><div class="big-timer"></div><div class="card-progress-wrap"><div class="card-progress-bar"><div class="card-progress-fill"></div><div class="card-progress-glow"></div></div><div class="card-pct"></div></div><div class="card-times"><span class="card-elapsed"></span><span class="card-remaining"></span></div><div class="card-next"></div></div></template>
<div id="announcement-overlay" class="announcement-overlay" hidden><span id="announcement-text" class="announcement-text"></span><span class="announcement-cursor">▋</span></div>
<script>window.SOC_DATA={people:<%-JSON.stringify(people)%>,userId:<%= authUserId %>};</script><script src="/js/dashboard.js"></script>
<script src="/js/profile-widget.js"></script>
</body></html>
